<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olivercode.WPFastr</RootNamespace>
    <AssemblyName>Olivercode.WPFastr</AssemblyName>
    <PackageId>Olivercode.WPFastr</PackageId>
    <Version>1.0.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Oliver</Authors>
    <Description>Small WPF behaviors and collections.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="WPFastr.Demo\**" />
    <Compile Remove="WPFastr.Demo\**" />
    <EmbeddedResource Remove="WPFastr.Demo\**" />
    <None Remove="WPFastr.Demo\**" />
    <Page Remove="WPFastr.Demo\**" />
  </ItemGroup>
</Project>
